# Copy to .env (gitignored) and fill in. Never commit real keys.
# SI layer — free-tier providers, server-side only.
# Primary: Google Gemini API (free key from https://aistudio.google.com/apikey, no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL_2=gemini-3.5-flash
# Fallback: Groq (free key from https://console.groq.com/keys, no card)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Voice-over for the demo video (ElevenLabs free tier; fallback = edge-tts, no key)
ELEVENLABS_API_KEY=
